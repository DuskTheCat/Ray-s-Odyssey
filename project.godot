[internationalization]

locale/translations=PackedStringArray("res://translations.en.translation", "res://translations.ja.translation", "res://translations.sv.translation", "res://translations.fr.translation")
locale/translations_pot_files=PackedStringArray("res://translations.csv")

[physics]

2d/run_on_separate_thread=true
common/physics_jitter_fix=0.16
2d/physics_engine="Rapier2D"
3d/physics_engine="Jolt Physics"
2d/solver/solver_iterations=8
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=2
